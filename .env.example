# --- Base de datos ---
DATABASE_URL=postgres://usuario:password@localhost:5432/endimaster
PGSSL=false

# --- Seguridad ---
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=cambia_esto_por_una_llave_de_32_caracteres_o_mas
JWT_SECRET=cambia_esto_por_otra_llave_distinta_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# --- QuickBooks (developer.intuit.com) ---
QBO_CLIENT_ID=tu_client_id_de_intuit
QBO_CLIENT_SECRET=tu_client_secret_de_intuit
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/api/connectors/quickbooks/callback

# --- Siigo (developers.siigo.com) ---
# El Partner-Id te lo asigna Siigo al registrarte como desarrollador/partner.
SIIGO_PARTNER_ID=tu_partner_id_de_siigo

# --- Google Sheets (console.cloud.google.com) ---
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/googlesheets/callback

# --- IA (nunca la pongas en el frontend) ---
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# --- Frontend ---
FRONTEND_URL=http://localhost:5500

PORT=3000
